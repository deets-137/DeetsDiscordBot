# Copy to .env (gitignored). Discord developer portal → your app → Bot → Reset Token.
DISCORD_TOKEN=your_bot_token_here

# Notion sync (notion_sync.py / scan.py --notion). Create an *internal* integration
# at https://www.notion.so/profile/integrations, then in Notion open the DeetsOTD
# page → ⋯ → Connections → add that integration so it can write there.
NOTION_TOKEN=secret_xxx
NOTION_PARENT_PAGE_ID=38d86876-b378-8019-8264-f2d923c56f1c
# Filled in automatically on the first sync; paste it back here to reuse the db.
NOTION_DB_ID=

# TMDB (letterboxd_web.py) — fills movie poster URLs into movies.json.
# Free: themoviedb.org → Settings → API → "API Key" (the short v3 key).
TMDB_API_KEY=

# Apple Music API (applemusic.py) — paid developer subscription. From a MusicKit
# key at developer.apple.com: the AuthKey_*.p8 path, its Key ID, and your Team ID.
# Scaffolded but NOT wired into enrich.py yet — see docs/APPLE_MUSIC.md.
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_KEY_ID=XXXXXXXXXX
APPLE_TEAM_ID=YYYYYYYYYY
APPLE_STOREFRONT=us
