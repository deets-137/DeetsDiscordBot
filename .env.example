# Copy to .env (gitignored). Discord developer portal → your app → Bot → Reset Token.
DISCORD_TOKEN=your_bot_token_here

# /vc and /dm (bot/voice.py). The host is the bot application's owner; add more host
# user ids here, comma-separated. DEETS_TAP overrides crates/tap/target/release/deets-tap.exe.
VOICE_USER_IDS=
DEETS_TAP=

# The Activity's relay (docs/features/ACTIVITY.md §12.2). Leave both empty: the bot runs with
# no Activity. The address is the relay Worker's host socket; the secret is the same value as
# the Worker's HOST_SECRET (make one with: openssl rand -hex 32).
LILDEETS_RELAY_URL=
LILDEETS_RELAY_SECRET=

# Notion sync (journal.notion_sync / journal.scan --notion). Create an *internal* integration
# at https://www.notion.so/profile/integrations, then in Notion open the DeetsOTD
# page → ⋯ → Connections → add that integration so it can write there.
NOTION_TOKEN=secret_xxx
NOTION_PARENT_PAGE_ID=your_parent_page_id_here
# Filled in automatically on the first sync; paste it back here to reuse the db.
NOTION_DB_ID=

# TMDB (journal.letterboxd_web) — fills movie poster URLs into movies.json.
# Free: themoviedb.org → Settings → API → "API Key" (the short v3 key).
TMDB_API_KEY=

# Apple Music API (journal/applemusic.py) — paid developer subscription. From a MusicKit
# key at developer.apple.com: the AuthKey_*.p8 path (keep it in secrets/), its Key ID, and
# your Team ID. See docs/integrations/APPLE-MUSIC.md.
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_KEY_ID=XXXXXXXXXX
APPLE_TEAM_ID=YYYYYYYYYY
APPLE_STOREFRONT=us
